# Copy to .env and fill in values. .env is gitignored.

# LangSmith — required for tracing. Get key at https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sentinel-dev

# Sentinel config (prefix SENTINEL_)
SENTINEL_ENV=dev
SENTINEL_LOG_LEVEL=INFO
SENTINEL_CHECKPOINT_DB=./data/checkpoints.sqlite
